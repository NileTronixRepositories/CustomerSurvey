        <section class="section graphics-section">
            <h2 class="section-title">@T("Graphics", "الرسوم البيانية")</h2>
            <div class="graphics-grid">
                <div class="chart-card">
                    <div class="chart-title">@T("Overall Satisfaction", "الرضا العام")</div>
                    <div class="chart-body">
                        @if (Model.Graphics.OverallSatisfactionPercentage.HasValue)
                        {
                            var satisfaction = Model.Graphics.OverallSatisfactionPercentage.Value;
                            @Raw(DonutSvg(
                                new[]
                                {
                                    (satisfaction, "#2563EB"),
                                    (Math.Max(0m, 100m - satisfaction), "#E2E8F0")
                                },
                                $"{satisfaction:0.##}%",
                                T("Satisfaction", "الرضا")))
                        }
                        else
                        {
                            @Raw(DonutSvg(Array.Empty<(decimal, string)>(), T("No Data", "لا توجد بيانات"), T("Satisfaction", "الرضا")))
                        }
                        <div class="chart-legend">
                            <div class="legend-row"><span>@T("Overall Satisfaction", "الرضا العام")</span><strong>@PercentOrDash(Model.Graphics.OverallSatisfactionPercentage)</strong></div>
                            <div class="legend-row"><span>@T("Average Score", "متوسط التقييم")</span><strong>@DecimalOrDash(Model.Graphics.AverageScoreValue) / 5</strong></div>
                        </div>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="chart-title">@T("Responses Scored vs Not Scored", "الردود المقيمة مقابل غير المقيمة")</div>
                    <div class="chart-body">
                        @Raw(DonutSvg(
                            Model.Graphics.TotalResponses > 0
                                ? new[]
                                {
                                    ((decimal)Model.Graphics.ScoredResponses, "#16A34A"),
                                    ((decimal)Model.Graphics.NotScoredResponses, "#94A3B8")
                                }
                                : Array.Empty<(decimal, string)>(),
                            Model.Graphics.TotalResponses > 0 ? Model.Graphics.TotalResponses.ToString() : T("No Data", "لا توجد بيانات"),
                            T("Responses", "الردود")))
                        <div class="chart-legend">
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#16A34A"></i>@T("Scored", "مقيمة")</span><strong>@Model.Graphics.ScoredResponses</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#94A3B8"></i>@T("Not Scored", "غير مقيمة")</span><strong>@Model.Graphics.NotScoredResponses</strong></div>
                        </div>
                    </div>
                </div>

                <div class="chart-card wide">
                    <div class="chart-title">@T("Response Score Distribution", "توزيع تقييم الردود")</div>
                    <div class="chart-body">
                        @Raw(DonutSvg(
                            Model.Graphics.ScoreDistributionTotal > 0
                                ? new[]
                                {
                                    ((decimal)Model.Graphics.ExcellentResponses, "#15803D"),
                                    ((decimal)Model.Graphics.GoodResponses, "#65A30D"),
                                    ((decimal)Model.Graphics.AverageResponses, "#EAB308"),
                                    ((decimal)Model.Graphics.PoorResponses, "#F97316"),
                                    ((decimal)Model.Graphics.CriticalResponses, "#DC2626")
                                }
                                : Array.Empty<(decimal, string)>(),
                            Model.Graphics.ScoreDistributionTotal > 0 ? Model.Graphics.ScoreDistributionTotal.ToString() : T("No Data", "لا توجد بيانات"),
                            T("Scored Responses", "الردود المقيمة")))
                        <div class="chart-legend">
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#15803D"></i>@T("Excellent", "ممتاز")</span><strong>@Model.Graphics.ExcellentResponses</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#65A30D"></i>@T("Good", "جيد")</span><strong>@Model.Graphics.GoodResponses</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#EAB308"></i>@T("Average", "متوسط")</span><strong>@Model.Graphics.AverageResponses</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#F97316"></i>@T("Poor", "ضعيف")</span><strong>@Model.Graphics.PoorResponses</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#DC2626"></i>@T("Critical", "حرج")</span><strong>@Model.Graphics.CriticalResponses</strong></div>
                        </div>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="chart-title">@T("Root vs Conditional Questions", "الأسئلة الرئيسية مقابل الشرطية")</div>
                    <div class="chart-body">
                        @Raw(DonutSvg(
                            Model.Graphics.RootQuestions + Model.Graphics.ConditionalQuestions > 0
                                ? new[]
                                {
                                    ((decimal)Model.Graphics.RootQuestions, "#2563EB"),
                                    ((decimal)Model.Graphics.ConditionalQuestions, "#F59E0B")
                                }
                                : Array.Empty<(decimal, string)>(),
                            (Model.Graphics.RootQuestions + Model.Graphics.ConditionalQuestions) > 0
                                ? (Model.Graphics.RootQuestions + Model.Graphics.ConditionalQuestions).ToString()
                                : T("No Data", "لا توجد بيانات"),
                            T("Questions", "الأسئلة")))
                        <div class="chart-legend">
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#2563EB"></i>@T("Root", "رئيسية")</span><strong>@Model.Graphics.RootQuestions</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#F59E0B"></i>@T("Conditional", "شرطية")</span><strong>@Model.Graphics.ConditionalQuestions</strong></div>
                        </div>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="chart-title">@T("Scored vs Non-Scored Answers", "الإجابات المحتسبة مقابل غير المحتسبة")</div>
                    <div class="chart-body">
                        @Raw(DonutSvg(
                            Model.Graphics.IncludedAnswers + Model.Graphics.NonScoredAnswers > 0
                                ? new[]
                                {
                                    ((decimal)Model.Graphics.IncludedAnswers, "#7C3AED"),
                                    ((decimal)Model.Graphics.NonScoredAnswers, "#CBD5E1")
                                }
                                : Array.Empty<(decimal, string)>(),
                            (Model.Graphics.IncludedAnswers + Model.Graphics.NonScoredAnswers) > 0
                                ? (Model.Graphics.IncludedAnswers + Model.Graphics.NonScoredAnswers).ToString()
                                : T("No Data", "لا توجد بيانات"),
                            T("Answers", "الإجابات")))
                        <div class="chart-legend">
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#7C3AED"></i>@T("Scored Answers", "الإجابات المحتسبة")</span><strong>@Model.Graphics.IncludedAnswers</strong></div>
                            <div class="legend-row"><span class="legend-label"><i class="legend-swatch" style="background:#CBD5E1"></i>@T("Non-Scored Answers", "الإجابات غير المحتسبة")</span><strong>@Model.Graphics.NonScoredAnswers</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">@T("Score Calculation Explanation", "شرح طريقة حساب التقييم")</h2>
            <div class="note">
                @if (ar)
                {
                    if (Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions)
                    {
                        <div>يتم حساب التقييم من الأسئلة الرئيسية فقط.</div>
                        <div>الأسئلة الشرطية تظهر في الشجرة والتحليل، لكنها لا تؤثر على تقييم النموذج الأساسي.</div>
                    }
                    else
                    {
                        <div>يتم حساب التقييم من أعمق سؤال قابل للتقييم داخل مسار الإجابة الشرطي.</div>
                        <div>لو أعمق سؤال غير قابل للتقييم، يتم الرجوع لآخر سؤال قابل للتقييم في نفس المسار.</div>
                    }
                    <div>أسئلة الاختيار الواحد والنجوم والوجوه التعبيرية يتم تقييمها من 1 إلى 5.</div>
                    <div>أسئلة الشكوى والصوت تظهر للتحليل فقط ولا تدخل مباشرة في حساب التقييم.</div>
                }
                else
                {
                    if (Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions)
                    {
                        <div>Score is calculated from root questions only.</div>
                        <div>Conditional questions are displayed in the flow and analysis, but they do not affect the main template score.</div>
                    }
                    else
                    {
                        <div>Score is calculated from the deepest scorable question in the answered conditional path.</div>
                        <div>If the deepest question is not scorable, the report uses the last scorable question in the same path.</div>
                    }
                    <div>SingleChoice, StarRating, and Smiles are scored from 1 to 5.</div>
                    <div>Complaint and Voice questions are displayed for analysis but are not scored directly.</div>
                }
            </div>
        </section>

        <section class="section page-break">
