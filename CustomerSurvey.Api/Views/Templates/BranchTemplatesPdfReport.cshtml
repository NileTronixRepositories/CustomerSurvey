                                    <td>@q.DisplayParentTrigger(ar)</td>
                                    <td>@QuestionTypeLabel(q.QuestionType)</td>
                                    @* <td>@q.TotalAnswers</td> *@
                                    <td>@DecimalOrDash(q.AverageValue)</td>
                                    <td>
                                        <span class="badge @(q.IsScoreIncluded ? "score-good" : "score-na")">
                                            @(q.IsScoreIncluded ? T("Yes", "نعم") : T("No", "لا"))
                                        </span>
                                    </td>
                                </tr>

                                @if (q.Options.Any())
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="options-wrap">
                                                <div class="options-title">@T("Options Distribution", "توزيع الاختيارات")</div>
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            <th>@T("Option", "الاختيار")</th>
                                                            <th>@T("Value", "القيمة")</th>
                                                            <th>@T("Count", "العدد")</th>
                                                            <th>@T("Percentage", "النسبة")</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var option in q.Options)
                                                        {
                                                            <tr>
                                                                <td>@option.DisplayLabel(ar)</td>
                                                                <td>@ValueOrDash(option.Value)</td>
                                                                <td>@option.Count</td>
                                                                <td>
                                                                    @option.Percentage.ToString("0.##", CultureInfo.InvariantCulture)%
                                                                    <div class="bar"><span style="width:@ProgressWidth(option.Percentage)%"></span></div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                <div class="response-details">
                    <h3 class="section-title">@T("Response Details", "تفاصيل الردود")</h3>
                    @{
                        var templateResponses = Model.Responses
                            .Where(x => x.TemplateId == summary.TemplateId && x.TemplateKind == summary.TemplateKind)
                            .OrderBy(x => x.SubmittedOnUtc)
                            .ThenBy(x => x.ResponseId)
                            .ToArray();
                    }

                    @if (!templateResponses.Any())
                    {
                        <div class="note warning">@T("No responses match the selected period.", "لا توجد ردود مطابقة للفترة المحددة.")</div>
                    }
                    else
                    {
                        @for (var responseIndex = 0; responseIndex < templateResponses.Length; responseIndex++)
                        {
                            var response = templateResponses[responseIndex];
                            var responseNumber = responseIndex + 1;

                            <article class="response-block">
                                <div class="response-summary">
                                    <div class="response-heading">
                                        <span>@T("Response", "الرد") #@responseNumber</span>
                                        <span class="badge @(response.IsScored ? "score-good" : "score-na")">
                                            @(response.IsScored ? T("Scored", "مُقيّم") : T("Not Scored", "غير مُقيّم"))
                                        </span>
                                    </div>

                                    <div class="response-meta-grid">
                                        <div class="response-meta-item">
                                            <div class="response-meta-label">@T("Submitted At", "وقت الإرسال")</div>
                                            <div class="response-meta-value">@ResponseDate(response.SubmittedOnUtc)</div>
                                        </div>
                                        <div class="response-meta-item">
                                            <div class="response-meta-label">@T("Operator", "المشغل")</div>
                                            <div class="response-meta-value">@(string.IsNullOrWhiteSpace(response.DisplayOperatorName(ar)) ? "—" : response.DisplayOperatorName(ar))</div>
                                        </div>
                                        <div class="response-meta-item">
                                            <div class="response-meta-label">@T("Scoring Status", "حالة التقييم")</div>
                                            <div class="response-meta-value">@(response.IsScored ? T("Scored", "مُقيّم") : T("Not Scored", "غير مُقيّم"))</div>
                                        </div>
                                        <div class="response-meta-item">
                                            <div class="response-meta-label">@T("Score", "التقييم")</div>
                                            <div class="response-meta-value">@(response.IsScored && response.AverageScoreValue.HasValue ? $"{response.AverageScoreValue.Value:0.00} / 5" : "—")</div>
                                        </div>
                                        <div class="response-meta-item">
                                            <div class="response-meta-label">@T("Score Percentage", "نسبة التقييم")</div>
                                            <div class="response-meta-value">@(response.IsScored && response.ScorePercentage.HasValue ? $"{response.ScorePercentage.Value:0.##}%" : "—")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="response-subtitle">@T("Custom Inputs", "الحقول المخصصة")</div>
                                @if (!response.CustomInputs.Any())
                                {
                                    <div class="muted">@T("No custom inputs.", "لا توجد حقول مخصصة.")</div>
                                }
                                else
                                {
                                    @foreach (var customInputChunk in response.CustomInputs
                                        .OrderBy(x => x.Order ?? int.MaxValue)
                                        .ThenBy(x => x.Name)
                                        .Chunk(8))
                                    {
                                        <table class="custom-input-table">
                                            <thead>
                                                <tr>
                                                    <th>@T("Custom Input", "الحقل المخصص")</th>
                                                    <th>@T("Value", "القيمة")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var customInput in customInputChunk)
                                                {
                                                    <tr>
                                                        <td>@customInput.Name</td>
                                                        <td>@customInput.DisplayValue</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }

                                <div class="response-subtitle">@T("Answers", "الإجابات")</div>
                                @if (!response.Answers.Any())
                                {
                                    <div class="muted">@T("No answers.", "لا توجد إجابات.")</div>
                                }
                                else
                                {
                                    <table class="answers-table">
                                        <thead>
                                            <tr>
                                                <th>@T("Question", "السؤال")</th>
                                                <th>@T("Answer", "الإجابة")</th>
                                                <th>@T("Option Value", "قيمة الاختيار")</th>
                                                <th>@T("Score Value", "قيمة التقييم")</th>
                                                <th>@T("Included In Score", "محتسبة في التقييم")</th>
                                                <th>@T("Score Inclusion Reason", "سبب الاحتساب")</th>
                                                <th>@T("Media", "الوسائط")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var answer in response.Answers.OrderBy(x => x.QuestionOrder ?? int.MaxValue).ThenBy(x => x.QuestionTextEn))
                                            {
                                                var media = MediaValue(answer);
                                                <tr>
                                                    <td>@answer.DisplayQuestionText(ar)</td>
                                                    <td>@BusinessAnswer(answer)</td>
                                                    <td>@(answer.QuestionType == QuestionType.SingleChoice ? ValueOrDash(answer.SelectedOptionValue) : "—")</td>
                                                    <td>@DecimalOrDash(answer.ScoreValue)</td>
                                                    <td>@IncludedLabel(answer.IncludedInScore)</td>
                                                    <td>@InclusionReason(answer.ScoreInclusionReason)</td>
                                                    <td>
                                                        @if (IsAbsoluteWebUrl(media))
                                                        {
                                                            <a class="media-link" href="@media">@(answer.QuestionType == QuestionType.Voice ? T("Open Voice", "فتح الصوت") : T("View Image", "عرض الصورة"))</a>
                                                        }
                                                        else
                                                        {
                                                            @(string.IsNullOrWhiteSpace(media) ? "—" : media)
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </article>
                        }
                    }
                </div>
            </section>
        }

        <section class="section page-break data-notes">
            <h2 class="section-title">@T("Data Quality Notes", "ملاحظات جودة البيانات")</h2>
            @if (ar)
            {
                <div class="note">
                    <ul>
                        <li>Authorized تعني النماذج الداخلية التي يتم الإجابة عليها بواسطة مستخدم مصرح له.</li>
                        <li>Anonymous تعني النماذج العامة التي يتم الإجابة عليها بدون تسجيل دخول.</li>
                        <li>الأسئلة التي لا تحتوي على قيمة تقييم تظهر للتحليل فقط ولا تدخل في متوسط التقييم.</li>
                        @* <li>أسئلة الصوت والشكوى لا تؤثر مباشرة على التقييم.</li> *@
                        <li>الأسئلة الشرطية قد يكون لها عدد إجابات أقل لأنها تظهر فقط عند تحقق شرط السؤال الأب.</li>
                        <li>النماذج بدون ردود يتم عرضها لكنها لا تدخل في متوسطات التقييم.</li>
                    </ul>
                </div>
            }
            else
            {
                <div class="note">
                    <ul>
                        <li>Authorized means internal templates answered by authenticated/authorized users.</li>
                        <li>Anonymous means public templates answered without login.</li>
                        <li>Questions without scoring values are displayed for analysis but excluded from average score.</li>
                        @* <li>Voice and Complaint questions do not directly affect the score.</li> *@
                        <li>Conditional questions may have fewer answers because they appear only when their parent trigger is selected.</li>
                        <li>Templates with zero responses are listed but excluded from scored averages.</li>
                    </ul>
                </div>
            }
        </section>
    </div>
</body>
</html>
