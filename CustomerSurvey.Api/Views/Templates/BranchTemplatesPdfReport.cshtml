@model CustomerSurvey.Application.Features.Reports.Query.GetBranchTemplatesPdfReport.BranchTemplatesPdfReportModel
@using System.Globalization
@using CustomerSurvey.Application.Features.Reports.Query.GetBranchTemplatesPdfReport
@using CustomerSurvey.Domain.Enums

@{
    var ar = Model.IsArabic;


    string T(string en, string arText) => ar ? arText : en;

    string ValueOrDash(object? value) => value is null ? "-" : value.ToString()!;

    string DecimalOrDash(decimal? value) =>
        value.HasValue ? value.Value.ToString("0.##", CultureInfo.InvariantCulture) : "-";

    string PercentOrDash(decimal? value) =>
        value.HasValue ? $"{value.Value.ToString("0.##", CultureInfo.InvariantCulture)}%" : "N/A";

    string PercentValue(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    string DateOrDash(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    string ProgressWidth(decimal value)
    {
        var clamped = value < 0 ? 0 : value > 100 ? 100 : value;
        return clamped.ToString("0.##", CultureInfo.InvariantCulture);
    }

    string TemplateKindLabel(ReportTemplateKind? kind)
    {
        if (!kind.HasValue)
        {
            return T("Authorized + Anonymous", "Authorized + Anonymous");
        }

        return kind.Value == ReportTemplateKind.Normal
            ? T("Authorized", "Authorized")
            : T("Anonymous", "Anonymous");
    }

    string ScoreModeText() =>
        Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions
            ? T("RootQuestions", "الأسئلة الرئيسية")
            : T("LowestConditionLevel", "أعمق مستوى شرطي");

    string ScoreStatusText(decimal? percentage)
    {
        if (!percentage.HasValue)
        {
            return T("No Score", "لا يوجد تقييم");
        }

        if (percentage.Value >= 80)
        {
            return T("Excellent", "ممتاز");
        }

        if (percentage.Value >= 60)
        {
            return T("Good", "جيد");
        }

        if (percentage.Value >= 40)
        {
            return T("Average", "متوسط");
        }

        if (percentage.Value >= 20)
        {
            return T("Poor", "ضعيف");
        }

        return T("Critical", "حرج");
    }

    string ScoreStatusClass(decimal? percentage)
    {
        if (!percentage.HasValue)
        {
            return "score-na";
        }

        if (percentage.Value >= 80)
        {
            return "score-excellent";
        }

        if (percentage.Value >= 60)
        {
            return "score-good";
        }

        if (percentage.Value >= 40)
        {
            return "score-average";
        }

        if (percentage.Value >= 20)
        {
            return "score-poor";
        }

        return "score-critical";
    }

    string QuestionTypeLabel(string type) =>
        type switch
        {
            "SingleChoice" => T("Single Choice", "اختيار واحد"),
            "StarRating" => T("Star Rating", "تقييم نجوم"),
            "Smiles" => T("Smiles", "وجوه تعبيرية"),
            "Complain" => T("Complaint", "شكوى"),
            "Voice" => T("Voice", "صوت"),
            "Image" => T("Image", "صورة"),
            _ => type
        };

    string ResponseDate(DateTime value) => value.ToString("dd/MM/yyyy HH:mm");

    string IncludedLabel(bool included) => included ? T("Yes", "نعم") : T("No", "لا");

    string InclusionReason(string reason)
    {
        if (!ar)
        {
            return reason;
        }

        return reason switch
        {
            "Non-Scorable Question" => "سؤال غير قابل للتقييم",
            "Root Question" => "سؤال رئيسي",
            "Selected By Lowest Condition Level" => "تم اختياره حسب أدنى مستوى شرطي",
            "Root Question - Not Included" => "سؤال رئيسي - غير محتسب",
            "Conditional Question - Not Included" => "سؤال شرطي - غير محتسب",
            _ => reason
        };
    }

    string BusinessAnswer(BranchTemplatesReportAnswer answer) => answer.QuestionType switch
    {
        QuestionType.SingleChoice => answer.DisplaySelectedOption(ar),
        QuestionType.StarRating => answer.StarRatingValue?.ToString() ?? answer.DisplayValue,
        QuestionType.Smiles => answer.SmileValue?.ToString() ?? answer.DisplayValue,
        QuestionType.Complain => answer.TextAnswer ?? answer.DisplayValue,
        QuestionType.Voice => T("Voice attachment", "مرفق صوتي"),
        QuestionType.Image => T("Image attachment", "مرفق صورة"),
        _ => answer.DisplayValue
    };

    string? MediaValue(BranchTemplatesReportAnswer answer) => answer.QuestionType switch
    {
        QuestionType.Voice => answer.VoiceFilePath ?? answer.VoiceFileName,
        QuestionType.Image => answer.ImageFilePath ?? answer.ImageFileName,
        _ => null
    };

    bool IsAbsoluteWebUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    string DonutSvg(
        IReadOnlyList<(decimal Value, string Color)> segments,
        string primaryText,
        string secondaryText)
    {
        var total = segments.Where(x => x.Value > 0).Sum(x => x.Value);
        var builder = new System.Text.StringBuilder();
        builder.Append("<svg class=\"donut\" viewBox=\"0 0 100 100\" role=\"img\">");
        builder.Append("<circle class=\"donut-track\" cx=\"50\" cy=\"50\" r=\"38\" pathLength=\"100\"></circle>");

        if (total > 0)
        {
            decimal offset = 0;
            foreach (var segment in segments.Where(x => x.Value > 0))
            {
                var percentage = segment.Value * 100m / total;
                builder.Append("<circle class=\"donut-segment\" cx=\"50\" cy=\"50\" r=\"38\" pathLength=\"100\" stroke=\"")
                    .Append(segment.Color)
                    .Append("\" stroke-dasharray=\"")
                    .Append(percentage.ToString("0.####", CultureInfo.InvariantCulture))
                    .Append(' ')
                    .Append((100m - percentage).ToString("0.####", CultureInfo.InvariantCulture))
                    .Append("\" stroke-dashoffset=\"")
                    .Append((-offset).ToString("0.####", CultureInfo.InvariantCulture))
                    .Append("\"></circle>");
                offset += percentage;
            }
        }

        builder.Append("<text class=\"donut-center-primary\" x=\"50\" y=\"49\">")
            .Append(System.Net.WebUtility.HtmlEncode(primaryText))
            .Append("</text><text class=\"donut-center-secondary\" x=\"50\" y=\"61\">")
            .Append(System.Net.WebUtility.HtmlEncode(secondaryText))
            .Append("</text></svg>");
        return builder.ToString();
    }

    string FlowLineClass(BranchTemplatesPdfFlowLine line) =>
        line.LineKind switch
        {
            BranchTemplatesPdfFlowLineKind.RootQuestion => "flow-line root",
            BranchTemplatesPdfFlowLineKind.ConditionalQuestion => "flow-line conditional",
            _ => "flow-line trigger"
        };
}

<!DOCTYPE html>
<html lang="@Model.Language" dir="@Model.Direction">
<head>
    <meta charset="utf-8" />
    <title>@T("Customer Survey Executive Report", "تقرير استبيانات العملاء التنفيذي")</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, "Tahoma", sans-serif;
            font-size: 12px;
            line-height: 1.45;
            color: #172033;
            margin: 0;
            padding: 0;
            direction: @Model.Direction;
            background: #ffffff;
        }

        @@page {
            /*
               Reserve a real top area for the logo.
               Important: this PDF renderer positions fixed elements from the content area,
               so the fixed header is moved upward into the reserved page margin.
            */
            margin: 74px 0 24px 0;
        }

        .pdf-report-header {
            /*
               Keep the logo repeated on every PDF page without covering report content.
               The negative top moves the header into the @@page top margin area.
            */
            position: fixed;
            top: -62px;
            left: 0;
            right: 0;
            height: 50px;
            background: #ffffff;
            border-bottom: 1px solid #eef2f7;
            z-index: 9999;
            overflow: visible;
        }

        .pdf-report-header img,
        .pdf-report-logo {
            position: absolute;
            top: 9px;
            right: 20px;
            width: auto !important;
            height: 32px !important;
            max-width: 160px !important;
            max-height: 32px !important;
            object-fit: contain;
            display: block;
            border: 0;
        }

        .page {
            padding: 0 20px 20px 20px;
        }

        .cover {
            background: #0b1f3a;
            color: #ffffff;
            border-radius: 8px;
            padding: 26px;
            margin-top: 0;
            margin-bottom: 18px;
            page-break-inside: avoid;
        }

        .cover-kicker {
            color: #9fb8d8;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0;
            margin-bottom: 10px;
        }

        .cover h1 {
            font-size: 30px;
            line-height: 1.15;
            margin: 0 0 6px;
            font-weight: 800;
        }

        .cover .arabic-title {
            color: #dbeafe;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 18px;
        }

        .cover-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 18px;
        }

        .cover-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(219, 234, 254, 0.22);
            border-radius: 7px;
            padding: 10px 12px;
            min-height: 58px;
        }

        .cover-label,
        .card-label {
            color: #65758b;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0;
        }

        .cover-label {
            color: #a9c4e5;
        }

        .cover-value {
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            margin-top: 4px;
        }

        .section {
            margin-top: 18px;
        }

        .section.page-break,
        .template-detail {
            page-break-before: always;
        }

        .section-title {
            font-size: 17px;
            font-weight: 800;
            color: #0b1f3a;
            margin: 0 0 10px;
            padding-bottom: 7px;
            border-bottom: 2px solid #d7e3f3;
            break-after: avoid;
            page-break-after: avoid;
        }

        .section-subtitle {
            color: #64748b;
            font-size: 11px;
            margin-top: -5px;
            margin-bottom: 10px;
        }

        .kpi-grid,
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 9px;
            margin-bottom: 12px;
        }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .card,
        .filter-card {
            border: 1px solid #dce5f1;
            border-radius: 7px;
            padding: 10px;
            background: #ffffff;
            page-break-inside: avoid;
        }

        .card {
            border-top: 4px solid #1d4ed8;
        }

        .card-value {
            color: #0b1f3a;
            font-size: 20px;
            font-weight: 800;
            margin-top: 4px;
        }

        .card-hint {
            color: #64748b;
            font-size: 10.5px;
            margin-top: 2px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 12px;
            page-break-inside: auto;
        }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }

        th {
            background: #0b1f3a;
            color: #ffffff;
            font-weight: 700;
            font-size: 11px;
        }

        th,
        td {
            border: 1px solid #dce5f1;
            padding: 7px 8px;
            vertical-align: top;
            overflow-wrap: anywhere;
            word-break: break-word;
            white-space: normal;
        }

        td {
            background: #ffffff;
        }

        tbody tr:nth-child(even) td {
            background: #f8fbff;
        }

        .text-right {
            text-align: right;
        }

        .muted {
            color: #64748b;
        }

        .badge {
            display: inline-block;
            padding: 3px 7px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .badge-authorized {
            color: #075985;
            background: #e0f2fe;
            border-color: #bae6fd;
        }

        .badge-anonymous {
            color: #6d28d9;
            background: #ede9fe;
            border-color: #ddd6fe;
        }

        .badge-root {
            color: #1d4ed8;
            background: #dbeafe;
            border-color: #bfdbfe;
        }

        .badge-conditional {
            color: #92400e;
            background: #fef3c7;
            border-color: #fde68a;
        }

        .score-excellent {
            color: #065f46;
            background: #d1fae5;
            border-color: #a7f3d0;
        }

        .score-good {
            color: #166534;
            background: #dcfce7;
            border-color: #bbf7d0;
        }

        .score-average {
            color: #854d0e;
            background: #fef9c3;
            border-color: #fde68a;
        }

        .score-poor {
            color: #9a3412;
            background: #ffedd5;
            border-color: #fed7aa;
        }

        .score-critical {
            color: #991b1b;
            background: #fee2e2;
            border-color: #fecaca;
        }

        .score-na {
            color: #475569;
            background: #f1f5f9;
            border-color: #e2e8f0;
        }

        .note {
            background: #f8fbff;
            border: 1px solid #dce5f1;
            border-inline-start: 4px solid #1d4ed8;
            border-radius: 7px;
            padding: 10px 12px;
            line-height: 1.6;
            page-break-inside: avoid;
        }

        .note.warning {
            background: #fffbeb;
            border-color: #fde68a;
            border-inline-start-color: #f59e0b;
        }

        .template-header {
            background: #0b1f3a;
            color: #ffffff;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 12px;
            page-break-inside: avoid;
        }

        .template-header h2 {
            margin: 0 0 8px;
            font-size: 22px;
            line-height: 1.2;
        }

        .template-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .flow-list {
            margin-top: 8px;
        }

        .flow-line {
            border: 1px solid #dce5f1;
            border-radius: 7px;
            padding: 7px 9px;
            margin-bottom: 6px;
            page-break-inside: avoid;
        }

        .flow-line.root {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .flow-line.conditional {
            background: #fffbeb;
            border-color: #fde68a;
        }

        .flow-line.trigger {
            background: #f8fafc;
            border-color: #e2e8f0;
        }

        .flow-number {
            color: #475569;
            font-weight: 800;
            margin-inline-end: 6px;
        }

        .flow-text {
            font-weight: 700;
            color: #102033;
        }

        .options-wrap {
            background: #ffffff;
            border: 1px solid #dce5f1;
            border-radius: 7px;
            padding: 8px;
        }

        .options-title {
            color: #0b1f3a;
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .bar {
            height: 8px;
            background: #e2e8f0;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 4px;
        }

        .bar span {
            display: block;
            height: 100%;
            background: #1d4ed8;
        }

        .data-notes ul {
            margin: 0;
            padding-inline-start: 18px;
        }

        .data-notes li {
            margin-bottom: 6px;
        }

        .graphics-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            align-items: start;
        }

        .chart-card {
            border: 1px solid #dce5f1;
            border-radius: 8px;
            padding: 10px;
            background: #ffffff;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .chart-card.wide {
            grid-column: span 2;
        }

        .chart-title {
            color: #0b1f3a;
            font-size: 12px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 6px;
        }

        .chart-body {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .donut {
            width: 132px;
            height: 132px;
            flex: 0 0 132px;
        }

        .donut-track {
            fill: none;
            stroke: #e2e8f0;
            stroke-width: 14;
        }

        .donut-segment {
            fill: none;
            stroke-width: 14;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        .donut-center-primary {
            fill: #0b1f3a;
            font-size: 15px;
            font-weight: 800;
            text-anchor: middle;
        }

        .donut-center-secondary {
            fill: #64748b;
            font-size: 7px;
            text-anchor: middle;
        }

        .chart-legend {
            flex: 1;
            min-width: 0;
        }

        .legend-row {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin: 4px 0;
            font-size: 10px;
        }

        .legend-label {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .legend-swatch {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            display: inline-block;
            flex: 0 0 9px;
        }

        .response-details {
            margin-top: 18px;
        }

        .response-block {
            margin: 0 0 16px;
        }

        .response-summary {
            display: inline-block;
            width: 100%;
            border-top: 3px solid #1d4ed8;
            padding-top: 8px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .response-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 800;
            color: #0b1f3a;
            margin-bottom: 8px;
            break-after: avoid;
            page-break-after: avoid;
        }

        .response-meta-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px;
            margin-bottom: 9px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .response-meta-item {
            border: 1px solid #dce5f1;
            border-radius: 5px;
            padding: 6px 7px;
        }

        .response-meta-label {
            color: #64748b;
            font-size: 9px;
            font-weight: 700;
        }

        .response-meta-value {
            color: #0b1f3a;
            font-size: 11px;
            font-weight: 700;
            margin-top: 2px;
        }

        .response-subtitle {
            font-size: 12px;
            font-weight: 800;
            color: #0b1f3a;
            margin: 9px 0 5px;
            break-after: avoid;
            page-break-after: avoid;
        }

        .custom-input-table tr {
            break-inside: auto;
            page-break-inside: auto;
        }

        .custom-input-table {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .answers-table tbody tr {
            break-inside: auto;
            page-break-inside: auto;
        }

        .answers-table td,
        .answers-table th {
            font-size: 9px;
            padding: 5px;
        }

        .media-link {
            color: #1d4ed8;
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <header class="pdf-report-header">
<img class="pdf-report-logo" src="data:image/png;base64," alt="Niletronix Logo" />
    </header>

    <div class="page">
        <section class="cover">
            <div class="cover-kicker">@T("Executive Management Report", "تقرير الإدارة التنفيذي")</div>
            <h1>Customer Survey Executive Report</h1>
            <div class="arabic-title">تقرير استبيانات العملاء التنفيذي</div>

            <div class="cover-grid">
                <div class="cover-card">
                    <div class="cover-label">@T("Branch", "الفرع")</div>
                    <div class="cover-value">@Model.BranchName</div>
                </div>
                <div class="cover-card">
                    <div class="cover-label">@T("Generated By", "تم الإنشاء بواسطة")</div>
                    <div class="cover-value">@Model.GeneratedBy</div>
                </div>
                <div class="cover-card">
                    <div class="cover-label">@T("Generated At UTC", "تاريخ الإنشاء UTC")</div>
                    <div class="cover-value">@Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
                <div class="cover-card">
                    <div class="cover-label">@T("Period", "الفترة")</div>
                    <div class="cover-value">@Model.FromDate.ToString("yyyy-MM-dd") - @Model.ToDate.ToString("yyyy-MM-dd")</div>
                </div>
                <div class="cover-card">
                    <div class="cover-label">@T("Selected Template", "النموذج المحدد")</div>
                    <div class="cover-value">@(string.IsNullOrWhiteSpace(Model.SelectedTemplateName) ? T("All Templates", "كل النماذج") : Model.SelectedTemplateName)</div>
                </div>
                <div class="cover-card">
                    <div class="cover-label">@T("Score Mode", "طريقة حساب التقييم")</div>
                    <div class="cover-value">@ScoreModeText()</div>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">@T("Applied Filters Summary", "ملخص الفلاتر المستخدمة")</h2>
            <div class="filter-grid">
                <div class="filter-card">
                    <div class="card-label">@T("Template", "النموذج")</div>
                    <div class="card-value">@(string.IsNullOrWhiteSpace(Model.SelectedTemplateName) ? T("All Templates", "كل النماذج") : Model.SelectedTemplateName)</div>
                </div>
                <div class="filter-card">
                    <div class="card-label">@T("Template Kind", "نوع النموذج")</div>
                    <div class="card-value">@TemplateKindLabel(Model.SelectedTemplateKind)</div>
                </div>
                <div class="filter-card">
                    <div class="card-label">@T("Top / Worst Questions", "عدد أفضل وأسوأ الأسئلة")</div>
                    <div class="card-value">@Model.TopWorstQuestionsCount</div>
                </div>
                <div class="filter-card">
                    <div class="card-label">@T("Worst Questions Score Range", "نطاق تقييم أسوأ الأسئلة")</div>
                    <div class="card-value">0% - @PercentValue(Model.WorstQuestionsMaxScorePercentage)%</div>
                </div>
                <div class="filter-card">
                    <div class="card-label">@T("Best Questions Score Range", "نطاق تقييم أفضل الأسئلة")</div>
                    <div class="card-value">@PercentValue(Model.BestQuestionsMinScorePercentage)% - 100%</div>
                </div>
            </div>
        </section>

        <section class="section">
            <h2 class="section-title">@T("Executive Dashboard Summary", "ملخص لوحة القيادة التنفيذية")</h2>
            <div class="kpi-grid">
                <div class="card">
