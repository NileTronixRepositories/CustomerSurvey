@model CustomerSurvey.Application.Features.Reports.Query.GetBranchTemplatesPdfReport.BranchTemplatesPdfReportModel
@using CustomerSurvey.Application.Features.Reports.Query.GetBranchTemplatesPdfReport

@{
    var ar = Model.IsArabic;
    string T(string en, string arText) => ar ? arText : en;
    string ValueOrDash(object? value) => value is null ? "-" : value.ToString()!;

    var scoreModeText = Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions
        ? T("Root Questions Only", "الأسئلة الرئيسية فقط")
        : T("Lowest Condition Level", "أقل مستوى في الأسئلة الشرطية");
}

<!DOCTYPE html>
<html lang="@Model.Language" dir="@Model.Direction">
<head>
    <meta charset="utf-8" />
    <title>@T("Customer Survey Report", "تقرير استبيانات العملاء")</title>

    <style>
            body {
                font-family: Arial, "Tahoma", sans-serif;
                font-size: 12px;
                color: #111827;
                margin: 0;
                padding: 0;
                direction: @Model.Direction;
            }

            .page {
                padding: 20px;
            }

            .header {
                border-bottom: 2px solid #111827;
                padding-bottom: 12px;
                margin-bottom: 16px;
            }

            .title {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .subtitle {
                color: #4b5563;
                font-size: 12px;
            }

            .section {
                margin-top: 18px;
                page-break-inside: avoid;
            }

            .section-title {
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 8px;
                padding: 8px 10px;
                background: #f3f4f6;
                border: 1px solid #e5e7eb;
            }

            .cards {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 8px;
                margin-bottom: 12px;
            }

            .card {
                border: 1px solid #e5e7eb;
                padding: 10px;
                background: #ffffff;
            }

            .card-label {
                color: #6b7280;
                font-size: 11px;
            }

            .card-value {
                font-size: 18px;
                font-weight: 700;
                margin-top: 4px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 12px;
            }

            th {
                background: #f9fafb;
                font-weight: 700;
            }

            th, td {
                border: 1px solid #e5e7eb;
                padding: 6px 8px;
                vertical-align: top;
            }

            .muted {
                color: #6b7280;
            }

            .badge {
                display: inline-block;
                padding: 2px 6px;
                border: 1px solid #d1d5db;
                background: #f9fafb;
                border-radius: 4px;
                font-size: 10px;
            }

            .note {
                background: #fffbeb;
                border: 1px solid #fde68a;
                padding: 10px;
                line-height: 1.6;
            }

            .page-break {
                page-break-before: always;
            }
    </style>
</head>

<body>
    <div class="page">

        <div class="header">
            <div class="title">@T("Customer Survey Report", "تقرير استبيانات العملاء")</div>
            <div class="subtitle">
                @T("Branch", "الفرع"): @Model.BranchName |
                @T("Generated By", "تم الإنشاء بواسطة"): @Model.GeneratedBy |
                @T("Generated At UTC", "تاريخ الإنشاء UTC"): @Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm")
            </div>
            <div class="subtitle">
                @T("Period", "الفترة"):
                @Model.FromDate.ToString("yyyy-MM-dd")
                -
                @Model.ToDate.ToString("yyyy-MM-dd")
            </div>
        </div>

        <div class="section">
            <div class="section-title">@T("Applied Filters", "الفلاتر المستخدمة")</div>
            <table>
                <tr>
                    <th>@T("Template", "النموذج")</th>
                    <td>@(string.IsNullOrWhiteSpace(Model.SelectedTemplateName) ? T("All Templates", "كل النماذج") : Model.SelectedTemplateName)</td>
                </tr>
                <tr>
                    <th>@T("Template Kind", "نوع النموذج")</th>
                    <td>@(Model.SelectedTemplateKind?.ToString() ?? T("Normal + Anonymous", "عادي + مجهول"))</td>
                </tr>
                <tr>
                    <th>@T("Score Calculation Mode", "طريقة حساب التقييم")</th>
                    <td>@scoreModeText</td>
                </tr>
                <tr>
                    <th>@T("Language", "اللغة")</th>
                    <td>@Model.Language</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <div class="section-title">@T("Executive Summary", "الملخص التنفيذي")</div>

            <div class="cards">
                <div class="card">
                    <div class="card-label">@T("Total Templates", "إجمالي النماذج")</div>
                    <div class="card-value">@Model.ExecutiveSummary.TotalTemplates</div>
                </div>

                <div class="card">
                    <div class="card-label">@T("Total Responses", "إجمالي الردود")</div>
                    <div class="card-value">@Model.ExecutiveSummary.TotalResponses</div>
                </div>

                <div class="card">
                    <div class="card-label">@T("Scored Answers", "الإجابات المحسوبة")</div>
                    <div class="card-value">@Model.ExecutiveSummary.TotalScoredAnswers</div>
                </div>

                <div class="card">
                    <div class="card-label">@T("Average Score", "متوسط التقييم")</div>
                    <div class="card-value">
                        @(Model.ExecutiveSummary.AverageScorePercentage.HasValue
                            ? $"{Model.ExecutiveSummary.AverageScorePercentage}%"
                            : "N/A")
                    </div>
                </div>
            </div>

            <table>
                <tr>
                    <th>@T("Average Score Value", "متوسط قيمة التقييم")</th>
                    <td>@(Model.ExecutiveSummary.AverageScoreValue.HasValue ? $"{Model.ExecutiveSummary.AverageScoreValue} / 5" : "N/A")</td>
                    <th>@T("Total Answers", "إجمالي الإجابات")</th>
                    <td>@Model.ExecutiveSummary.TotalAnswers</td>
                </tr>
                <tr>
                    <th>@T("Normal Responses", "ردود النماذج العادية")</th>
                    <td>@Model.ExecutiveSummary.TotalNormalResponses</td>
                    <th>@T("Anonymous Responses", "ردود النماذج المجهولة")</th>
                    <td>@Model.ExecutiveSummary.TotalAnonymousResponses</td>
                </tr>
                <tr>
                    <th>@T("Highest Rated Template", "أعلى نموذج تقييمًا")</th>
                    <td>@Model.ExecutiveSummary.HighestRatedTemplateName</td>
                    <th>@T("Lowest Rated Template", "أقل نموذج تقييمًا")</th>
                    <td>@Model.ExecutiveSummary.LowestRatedTemplateName</td>
                </tr>
                <tr>
                    <th>@T("Most Answered Template", "أكثر نموذج عليه ردود")</th>
                    <td>@Model.ExecutiveSummary.MostAnsweredTemplateName</td>
                    <th>@T("Templates Without Responses", "نماذج بدون ردود")</th>
                    <td>@Model.ExecutiveSummary.TemplatesWithoutResponses</td>
                </tr>
            </table>
        </div>

        <div class="section page-break">
            <div class="section-title">@T("Templates Overview", "ملخص النماذج")</div>

            @if (!Model.Templates.Any())
            {
                <div class="note">@T("No templates found for the selected filters.", "لا توجد نماذج مطابقة للفلاتر المحددة.")</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>@T("Template", "النموذج")</th>
                            <th>@T("Kind", "النوع")</th>
                            <th>@T("Questions", "الأسئلة")</th>
                            <th>@T("Root", "رئيسية")</th>
                            <th>@T("Conditional", "شرطية")</th>
                            <th>@T("Responses", "الردود")</th>
                            <th>@T("Answers", "الإجابات")</th>
                            <th>@T("Scored", "محسوبة")</th>
                            <th>@T("Avg Score", "متوسط التقييم")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Templates)
                        {
                            <tr>
                                <td>@item.DisplayName(ar)</td>
                                <td>@item.TemplateKindName</td>
                                <td>@item.TotalQuestions</td>
                                <td>@item.RootQuestions</td>
                                <td>@item.ConditionalQuestions</td>
                                <td>@item.TotalResponses</td>
                                <td>@item.TotalAnswers</td>
                                <td>@item.TotalScoredAnswers</td>
                                <td>@(item.AverageScorePercentage.HasValue ? $"{item.AverageScorePercentage}%" : "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="section page-break">
            <div class="section-title">@T("Answer Analytics", "تحليل الإجابات")</div>

            @if (!Model.Questions.Any())
            {
                <div class="note">@T("No answers found for the selected filters.", "لا توجد إجابات مطابقة للفلاتر المحددة.")</div>
            }
            else
            {
                @foreach (var group in Model.Questions.GroupBy(x => new { x.TemplateId, x.TemplateKind }))
                {
                    var first = group.First();

                    <h3>
                        @first.DisplayTemplateName(ar)
                        <span class="badge">@first.TemplateKind</span>
                    </h3>

                    <table>
                        <thead>
                            <tr>
                                <th>@T("Question", "السؤال")</th>
                                <th>@T("Type", "النوع")</th>
                                <th>@T("Root", "رئيسي")</th>
                                <th>@T("Answers", "الإجابات")</th>
                                <th>@T("Skipped", "لم يتم الإجابة")</th>
                                <th>@T("Answer Rate", "نسبة الإجابة")</th>
                                <th>@T("Avg Value", "متوسط القيمة")</th>
                                <th>@T("Score Included", "يدخل في التقييم")</th>
                                <th>@T("Scored Count", "عدد المحسوب")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in group)
                            {
                                <tr>
                                    <td>@q.DisplayQuestionText(ar)</td>
                                    <td>@q.QuestionType</td>
                                    <td>@(q.IsRootQuestion ? T("Yes", "نعم") : T("No", "لا"))</td>
                                    <td>@q.TotalAnswers</td>
                                    <td>@q.SkippedCount</td>
                                    <td>@q.AnswerRatePercentage%</td>
                                    <td>@(q.AverageValue.HasValue ? q.AverageValue.Value.ToString("0.##") : "-")</td>
                                    <td>@(q.IsScoreIncluded ? T("Yes", "نعم") : T("No", "لا"))</td>
                                    <td>@q.ScoreIncludedAnswersCount</td>
                                </tr>

                                @if (q.Options.Any())
                                {
                                    <tr>
                                        <td colspan="9">
                                            <table>
                                                <thead>
                                                    <tr>
                                                        <th>@T("Option", "الاختيار")</th>
                                                        <th>@T("Value", "القيمة")</th>
                                                        <th>@T("Count", "العدد")</th>
                                                        <th>@T("Percentage", "النسبة")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var option in q.Options)
                                                    {
                                                        <tr>
                                                            <td>@option.DisplayLabel(ar)</td>
                                                            <td>@ValueOrDash(option.Value)</td>
                                                            <td>@option.Count</td>
                                                            <td>@option.Percentage%</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }
        </div>

        @if (Model.CustomInputs.Any())
        {
            <div class="section page-break">
                <div class="section-title">@T("Anonymous Custom Inputs Summary", "ملخص بيانات النماذج المجهولة")</div>

                <table>
                    <thead>
                        <tr>
                            <th>@T("Template", "النموذج")</th>
                            <th>@T("Input", "الحقل")</th>
                            <th>@T("Type", "النوع")</th>
                            <th>@T("Required", "إجباري")</th>
                            <th>@T("Filled", "تم إدخاله")</th>
                            <th>@T("Empty", "فارغ")</th>
                            <th>@T("Completion", "نسبة الاكتمال")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var input in Model.CustomInputs)
                        {
                            <tr>
                                <td>@input.DisplayTemplateName(ar)</td>
                                <td>@input.DisplayLabel(ar)</td>
                                <td>@input.Type</td>
                                <td>@(input.IsRequired ? T("Yes", "نعم") : T("No", "لا"))</td>
                                <td>@input.FilledCount</td>
                                <td>@input.EmptyCount</td>
                                <td>@input.CompletionRatePercentage%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="section">
            <div class="section-title">@T("Scoring Rules", "قواعد حساب التقييم")</div>
            <div class="note">
                @if (ar)
                {
                    if (Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions)
                    {
                        <div>يتم حساب التقييم من الأسئلة الرئيسية فقط.</div>
                        <div>الأسئلة الشرطية تظهر في الإحصائيات لكنها لا تدخل في إجمالي تقييم النموذج.</div>
                    }
                    else
                    {
                        <div>يتم حساب التقييم من أعمق سؤال قابل للتقييم في مسار الإجابة.</div>
                        <div>إذا كان أعمق سؤال من نوع نص أو شكوى أو صوت، يتم الرجوع إلى آخر سؤال قابل للتقييم في نفس المسار.</div>
                        <div>إذا لم يتم فتح أسئلة شرطية، يتم حساب السؤال الرئيسي إذا كان قابلًا للتقييم.</div>
                    }

                    <div>أسئلة النجوم والوجوه التعبيرية يتم حسابها من 1 إلى 5.</div>
                    <div>أسئلة الاختيار الواحد تعتمد على قيمة الاختيار المحددة مسبقًا.</div>
                    <div>أسئلة الشكوى والصوت لا تدخل في حساب التقييم مباشرة.</div>
                }
                else
                {
                    if (Model.ScoreCalculationMode == ScoreCalculationMode.RootQuestions)
                    {
                        <div>Score is calculated from root questions only.</div>
                        <div>Conditional child questions are shown in analytics but do not affect the total template score.</div>
                    }
                    else
                    {
                        <div>Score is calculated from the deepest scorable question in the answered condition path.</div>
                        <div>If the deepest question is Text, Complaint, or Voice, the report falls back to the last scorable question in the same path.</div>
                        <div>If no conditional question is opened, the root question is used when it is scorable.</div>
                    }

                    <div>Star Rating and Smiles use values from 1 to 5.</div>
                    <div>Single Choice uses the configured option value.</div>
                    <div>Complaint and Voice questions do not directly affect scoring.</div>
                }
            </div>
        </div>

    </div>
</body>
</html>